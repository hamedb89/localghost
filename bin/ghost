#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

usage() {
  cat <<'EOF'
Usage:
  ghost check
  ghost release [patch|minor|major]
  ghost release retry <vX.Y.Z>
  ghost release status
EOF
}

if [ "${1:-}" = "check" ] && [ "$#" -eq 1 ]; then
  exec npm run release:check
fi

if [ "${1:-}" != "release" ]; then
  usage >&2
  exit 2
fi

case "${2:-}" in
  ""|patch|minor|major)
    bump=${2:-patch}
    ;;
  retry)
    tag=${3:-}
    case "$tag" in
      v[0-9]*.[0-9]*.[0-9]*)
        ;;
      *)
        printf '%s\n' 'ghost release retry requires a tag like v0.2.0.' >&2
        exit 2
        ;;
    esac
    exec gh workflow run publish-npm.yml --repo hamedb89/localghost --ref main -f "ref=$tag"
    ;;
  status)
    exec gh run list --repo hamedb89/localghost --workflow release.yml --limit 5
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [ "$(git branch --show-current)" != "main" ]; then
  printf '%s\n' 'ghost release must run from the main branch.' >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  printf '%s\n' 'ghost release requires a clean working tree.' >&2
  exit 1
fi

git push origin main
gh workflow run release.yml --repo hamedb89/localghost --ref main -f "bump=$bump"
printf 'Dispatched %s release. Track it with: ./bin/ghost release status\n' "$bump"
